# Browser / client components
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:8001

# Server-side API URL (production only — when NEXT_PUBLIC_API_URL is not localhost).
# Local/Docker SSR uses the Next.js rewrites (set API_REWRITE_TARGET in Docker).
# API_URL=http://internal-api:8001/api/v1
# API_REWRITE_TARGET=http://saransh-api:8001
