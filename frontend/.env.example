# NextAuth — Google sign-in. Provisioning runbook: docs/google-oauth-setup.md
# Must be the origin you browse the app on: it is what the Google redirect URI is registered
# against. On Vercel set the production origin, not this one.
NEXTAUTH_URL=http://localhost:3001
# Generate your own, one per environment — never reuse the production value:
#   openssl rand -base64 32
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Google OAuth client (Web application) — Saransh's own client, not Rajniti's.
# Scopes: openid email profile. Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# Real values belong in frontend/.env (gitignored) and in Vercel. Never commit them here.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Backend API URL (browser / client components; also used to derive Next.js /api/v1 rewrite origin)
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Server-side API URL (production only — when NEXT_PUBLIC_API_URL is not localhost).
# Local/Docker SSR uses the Next.js rewrites (set API_REWRITE_TARGET in Docker).
# API_URL=http://internal-api:8001/api/v1
# API_REWRITE_TARGET=http://saransh-api:8001

# Canonical site URL (SEO: Open Graph, sitemap, canonical links). Defaults to NEXTAUTH_URL or localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Analytics 4 — leave empty to disable tracking (no GA integration yet; mirrors Rajniti's key)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Logging (pino). Defaults to debug locally, info in production.
NEXT_PUBLIC_LOG_LEVEL=debug
