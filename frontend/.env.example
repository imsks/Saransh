# NextAuth Configuration
# Saransh has no sign-in yet — these mirror Rajniti's keys for parity and are unused until auth ships.
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your_secret_key

# Google OAuth (unused until sign-in ships — placeholders for parity with Rajniti)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Backend API URL (browser / client components; also used to derive Next.js /api/v1 rewrite origin)
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Server-side API URL (production only — when NEXT_PUBLIC_API_URL is not localhost).
# Local/Docker SSR uses the Next.js rewrites (set API_REWRITE_TARGET in Docker).
# API_URL=http://internal-api:8001/api/v1
# API_REWRITE_TARGET=http://saransh-api:8001

# Canonical site URL (SEO: Open Graph, sitemap, canonical links). Defaults to NEXTAUTH_URL or localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# PostHog analytics (see docs/adr/0004-posthog-for-saransh-analytics.md).
# Leave the key empty to disable analytics entirely — no SDK download, no network requests.
NEXT_PUBLIC_POSTHOG_KEY=
# Where the browser sends events. Defaults to /ingest, the first-party proxy in next.config.mjs.
# NEXT_PUBLIC_POSTHOG_HOST=/ingest
# Fraction of sessions recorded by session replay, 0–1. 0 turns replay off. Defaults to 0.1.
# Baked in at build time: changing it needs a redeploy, not a code change.
# NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE_RATE=0.1
# Where the /ingest proxy forwards to. Default to PostHog Cloud US.
# POSTHOG_PROXY_INGEST_HOST=https://us.i.posthog.com
# POSTHOG_PROXY_ASSETS_HOST=https://us-assets.i.posthog.com

# Logging (pino). Defaults to debug locally, info in production.
NEXT_PUBLIC_LOG_LEVEL=debug
