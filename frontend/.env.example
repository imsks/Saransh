# NextAuth Configuration
# Saransh has no sign-in yet — these mirror Rajniti's keys for parity and are unused until auth ships.
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your_secret_key

# Google OAuth (unused until sign-in ships — placeholders for parity with Rajniti)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Backend API URL (browser / client components; also used to derive Next.js /api/v1 rewrite origin)
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Server-side API URL (production only — when NEXT_PUBLIC_API_URL is not localhost).
# Local/Docker SSR uses the Next.js rewrites (set API_REWRITE_TARGET in Docker).
# API_URL=http://internal-api:8001/api/v1
# API_REWRITE_TARGET=http://saransh-api:8001

# Canonical site URL (SEO: Open Graph, sitemap, canonical links). Defaults to NEXTAUTH_URL or localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# PostHog analytics (see docs/adr/0004-posthog-for-saransh-analytics.md).
# Leave the key empty to disable analytics entirely — no SDK boot, no network requests.
# NEXT_PUBLIC_POSTHOG_HOST is optional and defaults to PostHog Cloud US.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Logging (pino). Defaults to debug locally, info in production.
NEXT_PUBLIC_LOG_LEVEL=debug
