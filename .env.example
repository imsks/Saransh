# Database — Saransh's own Postgres from docker-compose.yml
# Inside Docker (default): reach the service by name on the compose network.
DATABASE_URL=postgresql://rajniti:rajniti@postgres:5432/rajniti
# Running the API on the host instead? Use the published port:
# DATABASE_URL=postgresql://rajniti:rajniti@127.0.0.1:5433/rajniti

# Story Ingestion API Key (required for POST /api/stories)
SARANSH_INGEST_API_KEY=your_ingest_api_key_here

# Application Configuration
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration (8001 avoids conflict with Rajniti on 8000)
HOST=0.0.0.0
PORT=8001

# Optional: skip auto table creation on startup
# SKIP_DB_AUTO_CREATE=1
