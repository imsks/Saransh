# Database — shared Rajniti Postgres (start via `cd ../Rajniti && make up`)
# Default Rajniti docker-compose credentials:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rajniti
# If your Rajniti volume was initialized with the compose defaults:
# DATABASE_URL=postgresql://rajniti:rajniti@127.0.0.1:5432/rajniti

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Story Ingestion API Key (required for POST /api/stories)
SARANSH_INGEST_API_KEY=your_ingest_api_key_here

# Application Configuration
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration (8001 avoids conflict with Rajniti on 8000)
HOST=0.0.0.0
PORT=8001

# Redis Configuration (for caching later)
REDIS_URL=redis://localhost:6379

# Optional: skip auto table creation on startup
# SKIP_DB_AUTO_CREATE=1
